{
    "name": "mailyte/laravel-email-templates",
    "description": "The largest open-source library of ready-to-use HTML email templates for Laravel and PHP: 50 free, responsive, dark-mode transactional email templates -- welcome, verify email, password reset, invoice, receipt, newsletter and more -- each with its own design, contrast-audited to WCAG AA, deliverability-checked, on a sandboxed block engine.",
    "keywords": [
        "laravel",
        "laravel-package",
        "php",
        "email",
        "email-templates",
        "html-email",
        "responsive-email",
        "transactional-email",
        "transactional",
        "mail",
        "mailable",
        "smtp",
        "email-design",
        "email-template-library",
        "email-builder",
        "dark-mode",
        "accessibility",
        "wcag",
        "deliverability",
        "spam-score",
        "gmail",
        "outlook",
        "blade",
        "twig",
        "welcome-email",
        "password-reset",
        "verify-email",
        "invoice",
        "receipt",
        "newsletter",
        "notification",
        "onboarding",
        "billing",
        "design-system",
        "design-tokens",
        "open-source",
        "laravel-notifications",
        "mailmessage",
        "notifications"
    ],
    "homepage": "https://github.com/Techies-Africa/mailyte-laravel-email-templates",
    "license": "MIT",
    "authors": [
        {
            "name": "Confidence Ugolo",
            "homepage": "https://www.linkedin.com/in/confidence-ugolo",
            "role": "Creator, original author and founder of Mailyte"
        },
        {
            "name": "Joel Omojefe",
            "homepage": "https://www.linkedin.com/in/joel-omojefe",
            "role": "Co-author"
        },
        {
            "name": "Techies Africa",
            "homepage": "https://techies.africa",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "opis/json-schema": "^2.3",
        "symfony/html-sanitizer": "^7.0",
        "tijsverkoyen/css-to-inline-styles": "^2.2",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-intl": "Locale-aware currency and number formatting in billing templates. Without it a table-driven fallback formatter is used."
    },
    "autoload": {
        "psr-4": {
            "Mailyte\\EmailTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mailyte\\EmailTemplates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:check": "pint --test",
        "preview": "@php vendor/bin/testbench serve",
        "check": [
            "@format:check",
            "@analyse",
            "@lint",
            "@deliverability",
            "@test"
        ],
        "lint": "@php vendor/bin/testbench mailyte:lint --strict",
        "deliverability": "@php vendor/bin/testbench mailyte:deliverability --strict"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mailyte\\EmailTemplates\\EmailTemplatesServiceProvider"
            ],
            "aliases": {
                "Mailyte": "Mailyte\\EmailTemplates\\Facades\\Mailyte"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "type": "library",
    "support": {
        "issues": "https://github.com/Techies-Africa/mailyte-laravel-email-templates/issues",
        "source": "https://github.com/Techies-Africa/mailyte-laravel-email-templates",
        "docs": "https://github.com/Techies-Africa/mailyte-laravel-email-templates/tree/main/docs"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "analyse": "Run static analysis",
        "format": "Fix code style",
        "preview": "Serve the preview gallery at /mailyte",
        "check": "Everything CI runs",
        "lint": "Check every template bundle against the schema and house rules",
        "deliverability": "Check what a spam filter makes of every rendered message"
    }
}
