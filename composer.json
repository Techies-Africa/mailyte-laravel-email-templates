{
    "name": "mailyte/email-templates",
    "description": "A repository of production-ready, mobile-responsive, deliverability-checked email templates for Laravel, with a themeable block engine and a sandboxed template format anyone can contribute to.",
    "keywords": [
        "laravel",
        "email",
        "email-templates",
        "transactional-email",
        "mail",
        "responsive-email",
        "deliverability"
    ],
    "homepage": "https://github.com/mailyte/email-templates",
    "license": "MIT",
    "authors": [
        {
            "name": "Mailyte",
            "homepage": "https://mailyte.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/mail": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "opis/json-schema": "^2.3",
        "symfony/html-sanitizer": "^7.0",
        "tijsverkoyen/css-to-inline-styles": "^2.2",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0",
        "spatie/pest-plugin-snapshots": "^2.2"
    },
    "suggest": {
        "ext-intl": "Locale-aware currency and number formatting in billing templates. Without it a table-driven fallback formatter is used."
    },
    "autoload": {
        "psr-4": {
            "Mailyte\\EmailTemplates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mailyte\\EmailTemplates\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:snapshots": "pest --group=snapshots",
        "check": [
            "@lint:templates",
            "@analyse",
            "@test"
        ],
        "lint:templates": "@php vendor/bin/testbench mailyte:lint --all",
        "preview": "@php vendor/bin/testbench mailyte:preview",
        "new-template": "@php vendor/bin/testbench mailyte:make-template",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mailyte\\EmailTemplates\\EmailTemplatesServiceProvider"
            ],
            "aliases": {
                "Mailyte": "Mailyte\\EmailTemplates\\Facades\\Mailyte"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
