{
    "slug": "receipt",
    "name": "Payment receipt",
    "description": "Confirms a payment already taken: what was charged, to which card, and where to find the invoice.",
    "version": "1.0.0",
    "engine": "^1.0",
    "tier": "core",
    "type": "transactional",
    "category": "billing",
    "supported_layouts": [
        "plain",
        "minimal",
        "branded"
    ],
    "audience": [
        "saas",
        "fintech",
        "ecommerce"
    ],
    "tone": "neutral",
    "tags": [
        "receipt",
        "billing",
        "payment",
        "confirmation"
    ],
    "authors": [
        {
            "name": "Confidence Ugolo",
            "url": "https://www.linkedin.com/in/confidence-ugolo"
        },
        {
            "name": "Joel Omojefe",
            "url": "https://www.linkedin.com/in/joel-omojefe"
        }
    ],
    "license": "MIT",
    "origin": {
        "kind": "original",
        "note": "Design: docket — narrow measure, mono figures, dotted rules, the amount stated once and large."
    },
    "subject": "Receipt for {{ amount }} — {{ product.name }}",
    "preheader": "Paid on {{ paid_at }}. Keep this for your records.",
    "blocks_used": [
        "button",
        "divider",
        "heading",
        "key_value",
        "note",
        "stat_row",
        "text"
    ],
    "variables": {
        "amount": {
            "type": "money",
            "description": "What was charged, formatted at the call site — decimal separators are not universal. Set at display size as the one figure that matters.",
            "required": true,
            "example": "$29.00"
        },
        "paid_at": {
            "type": "datetime",
            "description": "When the payment went through.",
            "required": true,
            "example": "24 August 2026"
        },
        "description": {
            "type": "string",
            "description": "What the charge was for, in the words the customer would use.",
            "default": "",
            "example": "Pro plan, monthly"
        },
        "card_brand": {
            "type": "string",
            "description": "Card brand, for recognition.",
            "default": "",
            "example": "Visa"
        },
        "card_last4": {
            "type": "string",
            "description": "Last four digits. Never more than four — a receipt is not a place to restate a card number.",
            "default": "",
            "example": "4242"
        },
        "receipt_number": {
            "type": "string",
            "description": "Reference the customer can quote to support.",
            "default": "",
            "example": "RCP-2026-0184"
        },
        "line_items": {
            "type": "array",
            "description": "Optional breakdown as `label`/`value` pairs. A single-line charge needs none.",
            "default": [],
            "example": [
                {
                    "label": "Pro plan",
                    "value": "$29.00"
                }
            ]
        },
        "invoice_url": {
            "type": "url",
            "description": "Where the full invoice or PDF lives.",
            "default": "",
            "example": "https://example.com/invoices/RCP-2026-0184"
        },
        "button_label": {
            "type": "string",
            "description": "Label for the invoice link.",
            "default": "View full invoice"
        },
        "footer_legal": {
            "type": "text",
            "description": "Tax or company registration line, which varies by jurisdiction.",
            "default": ""
        }
    }
}
