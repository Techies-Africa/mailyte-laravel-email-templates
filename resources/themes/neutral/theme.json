{
    "$schema": "../../schema/theme.schema.json",
    "name": "neutral",
    "description": "Brand-free default. Restrained blue accent, system font stack, mid-tone surfaces that survive Outlook's dark-mode inversion.",
    "tokens": {
        "color": {
            "primary": {
                "light": "#2563EB",
                "dark": "#7BA6F7"
            },
            "primary_text": {
                "light": "#FFFEFC",
                "dark": "#0F1729"
            },
            "bg": {
                "light": "#F2F4F7",
                "dark": "#141618"
            },
            "surface": {
                "light": "#FAFAFA",
                "dark": "#1E2124"
            },
            "surface_alt": {
                "light": "#F0F2F5",
                "dark": "#26292D"
            },
            "text": {
                "light": "#1A1A1A",
                "dark": "#ECEDEE"
            },
            "text_muted": {
                "light": "#5A6270",
                "dark": "#A8AFBA"
            },
            "text_subtle": {
                "light": "#7C8492",
                "dark": "#8A919C"
            },
            "border": {
                "light": "#DFE3E8",
                "dark": "#34383D"
            },
            "link": {
                "light": "#2563EB",
                "dark": "#7BA6F7"
            },
            "success": {
                "light": "#127A45",
                "dark": "#5FCB8E"
            },
            "warning": {
                "light": "#9A6200",
                "dark": "#F0B355"
            },
            "danger": {
                "light": "#B4241C",
                "dark": "#F58077"
            },
            "info": {
                "light": "#1B6FA8",
                "dark": "#6EB6E5"
            }
        },
        "font": {
            "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
            "heading": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
            "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
        },
        "type": {
            "h1": {
                "size": "28px",
                "line_height": "36px",
                "weight": "700",
                "letter_spacing": "-0.02em"
            },
            "h2": {
                "size": "22px",
                "line_height": "30px",
                "weight": "700",
                "letter_spacing": "-0.01em"
            },
            "h3": {
                "size": "18px",
                "line_height": "26px",
                "weight": "600",
                "letter_spacing": "0"
            },
            "body": {
                "size": "16px",
                "line_height": "26px",
                "weight": "400",
                "letter_spacing": "0"
            },
            "small": {
                "size": "14px",
                "line_height": "22px",
                "weight": "400",
                "letter_spacing": "0"
            },
            "footer": {
                "size": "13px",
                "line_height": "20px",
                "weight": "400",
                "letter_spacing": "0"
            },
            "button": {
                "size": "16px",
                "line_height": "16px",
                "weight": "600",
                "letter_spacing": "0",
                "transform": "none"
            },
            "code": {
                "size": "32px",
                "line_height": "40px",
                "weight": "700",
                "letter_spacing": "0.18em"
            }
        },
        "radius": {
            "sm": "4px",
            "md": "6px",
            "lg": "10px",
            "pill": "999px"
        },
        "spacing": {
            "xs": "8px",
            "sm": "12px",
            "md": "20px",
            "lg": "32px",
            "xl": "48px"
        },
        "layout": {
            "width": "600px",
            "gutter": "24px",
            "outer_padding": "32px"
        },
        "button": {
            "padding_y": "14px",
            "padding_x": "28px",
            "min_height": "44px"
        },
        "logo": {
            "url": null,
            "dark_url": null,
            "alt": "",
            "width": "140",
            "height": null,
            "align": "left"
        },
        "footer": {
            "legal": null,
            "address": null,
            "unsubscribe_text": "Unsubscribe",
            "preferences_text": "Email preferences",
            "reason": null,
            "show_social": null,
            "show_address": null,
            "show_copyright": null,
            "show_reason": null,
            "copyright": null,
            "social_style": "round",
            "social_heading": "",
            "social_icon_base": null,
            "social_icon_ink": null,
            "social_icon_size": "22",
            "show_unsubscribe": null,
            "unsubscribe_note": null
        },
        "social": [],
        "shadow": {
            "button": "0 4px 10px rgba(37,99,235,.25)",
            "card": "0 2px 8px rgba(15,23,42,.06)",
            "canvas": "0 1px 2px rgba(15,23,42,.04), 0 12px 32px rgba(15,23,42,.06)"
        },
        "header": {
            "gradient": null,
            "accent_bar": null,
            "show_logo": null,
            "align": null,
            "banner_url": null,
            "banner_alt": "",
            "banner_height": "180",
            "banner_url_link": null,
            "logo_on_banner": false
        }
    }
}
